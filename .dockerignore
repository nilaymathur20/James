# Version-control and local configuration
.git/
.github/
.env
.env.*
!*.env.example
backend/.env

# Local assistant data: never copy indexed content, history, backups, or audit
# metadata into a Docker build context or image layer.
data/
history/
backups/
output_files/
runtime/
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Local models and voice models are mounted deliberately when needed, never
# baked into the application image by accident.
models/
*.gguf
*.bin
*.onnx

# Language/tooling output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
build/
dist/
frontend/node_modules/
frontend/dist/
.npm/
.cache/

# Editor and OS files
.DS_Store
Thumbs.db
*.swp
*.swo
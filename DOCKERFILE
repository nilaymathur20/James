# syntax=docker/dockerfile:1

# Build the React UI once. The runtime image does not need Node or Vite.
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# The default runtime intentionally contains only the lightweight offline RAG
# dependencies. Vosk, a local GGUF model, and cloud credentials are not baked
# into the image.
FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

# A fixed non-root account is the secure default for direct `docker run` use.
# Compose may override its numeric UID/GID to match the local desktop user so
# explicitly mounted document folders remain readable without loosening them.
RUN groupadd --gid 10001 james \
    && useradd --uid 10001 --gid james --create-home --home-dir /home/james james \
    && mkdir -p /app/data /app/history /app/backups /app/output_files /workspace \
    && chown -R james:james /app /workspace

COPY --chown=james:james backend/ /app/backend/
COPY --from=frontend-build --chown=james:james /src/frontend/dist /app/frontend/dist

USER james
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3).read()"]

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
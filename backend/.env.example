# James backend environment — copy to backend/.env and fill in real values.
# No example secrets; leave optional keys blank to disable that provider.

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Persistence ---
RAG_DB_PATH=data/rag_index.db
AUTO_INDEX_ENABLED=true
AUTO_INDEX_INTERVAL_SECONDS=1800

# --- Privacy / chat history ---
AI_MODE=offline
CHAT_HISTORY_ENABLED=true

# --- Optional local llama.cpp ---
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
# LOCAL_LLM_MODEL=qwen-small-instruct-q4
# LOCAL_LLM_MAX_TOKENS=384
# LOCAL_LLM_TIMEOUT_SECONDS=90

# --- Optional cloud chat: pick ONE provider ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MAX_TOKENS=4096
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# NEMOTRON_API_KEY=
# NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Optional Vosk push-to-talk ---
# VOSK_MODEL_PATH=/absolute/path/to/vosk-model-small-en-us-0.15
# VOSK_KEEP_LOADED=false

# --- WebSocket ---
WS_ALLOWED_ORIGINS=
WS_ALLOW_MISSING_ORIGIN=false